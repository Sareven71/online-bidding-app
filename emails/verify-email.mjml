<mjml>
    <mj-head>
        <mj-title>Say hello to card</mj-title>
        <mj-font name="Roboto" href="https://fonts.googleapis.com/css?family=Montserrat:300,400,500"></mj-font>
        <mj-attributes>
            <mj-all font-family="Montserrat, Helvetica, Arial, sans-serif"></mj-all>
            <mj-text font-weight="400" font-size="16px" color="#000000" line-height="24px"></mj-text>
            <mj-section padding="0px"></mj-section>
        </mj-attributes>
    </mj-head>
    <mj-body background-color="#F2F2F2">
        <mj-section padding="10px 0 20px 0">
            <mj-column>
                <mj-text align="center" color="#9B9B9B" font-size="11px">Hope you are doing well !</mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding="20px 20px 0 20px" background-color="#FFFFFF">
            <mj-column>
                <mj-text align="center" font-weight="300" padding="30px 40px 10px 40px" font-size="32px"
                    line-height="40px" color="#5FA91D">Greetings from Self Bidding</mj-text>
            </mj-column>
        </mj-section>
        <mj-section padding="10px 20px" background-color="#FFFFFF">
            <mj-column>
                <mj-divider width="30px" border-width="3px" border-color="#9B9B9B"></mj-divider>
            </mj-column>
        </mj-section>
        <mj-section padding="0 20px 20px 20px" background-color="#FFFFFF">
            <mj-column width="80%">
                <mj-text align="center" padding-top="10px" font-weight="500" padding="0px">Response for your Email
                    Verification request.</mj-text>
            </mj-column>
        </mj-section>
        <mj-section background-url="https://static.mailjet.com/mjml-website/templates/card-bg.jpg"
            background-size="cover" background-repeat="no-repeat">
            <mj-column width="100%">
                <mj-image src="https://static.mailjet.com/mjml-website/templates/card-lineshadow.png" alt=""
                    align="center" border="none" padding="0px"></mj-image>

                <mj-button align="center" background-color="#5FA91D" color="#FFFFFF" border-radius="2px" href="<%= code %>"
                    target="_self" inner-padding="15px 30px" padding-bottom="100px" padding-top="20px">Verify Email</mj-button>
            </mj-column>
        </mj-section>
        <mj-section padding="50px 0 0 0" background-color="#FFFFFF">
            <mj-column>
                <mj-image src="https://static.mailjet.com/mjml-website/templates/card-bottom.png" alt="bottom border"
                    align="center" border="none" padding="0px"></mj-image>
            </mj-column>
        </mj-section>

    </mj-body>
</mjml>