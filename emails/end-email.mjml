<mjml>
  <mj-head>
    <mj-font
      name="Manrope"
      href="https://fonts.googleapis.com/css?family=Manrope"
    ></mj-font>
    <mj-attributes>
      <mj-all font-family="Manrope, Helvetica, Arial, sans-serif"></mj-all>
      <mj-text
        font-weight="400"
        font-size="14px"
        color="#ffffff"
        line-height="22px"
      ></mj-text>
    </mj-attributes>
    <mj-style>
      .lc-text a {
        color: #77e375 !important;
        text-decoration: underline;
      }
      .lc-shadow {
        border: 1px solid #1b301b !important;
      }
      .lc-button td {
        border: 2px solid #636b63;
        border-style: dashed;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#070e07">
    <mj-section
      css-class="lc-shadow"
      border-radius="20px"
      background-color="#0C170C"
      padding="30px 40px"
    >
      <mj-column width="100%">
        <!-- Logo -->

        <mj-spacer height="40px"></mj-spacer>
        <!-- Image -->
        <mj-image
          padding="0px"
          width="180px"
          src="https://github.com/ricfreire/mautic-theme-loyalclient/blob/main/assets/gift.png?raw=true"
        ></mj-image>
        <mj-spacer height="30px"></mj-spacer>
        <mj-text
          color="#fff"
          padding="0px"
          align="center"
          font-size="28px"
          line-height="34px"
          >Congratulations!</mj-text
        >
        <mj-spacer height="30px"></mj-spacer>
        <mj-text
          color="#fff"
          css-class="lc-text"
          padding="0px"
          line-height="22px"
          >The Item <%= itemName %> is now Yours. Login to the app and collect
          your Item.</mj-text
        >
        <mj-spacer height="30px"></mj-spacer>
        <mj-spacer height="20px"></mj-spacer>
        <mj-text
          padding="0px"
          align="center"
          color="#B4B4B4"
          css-class="lc-text"
          line-height="22px"
          >With warm regards - Self Bidding</mj-text
        >
        <mj-spacer height="40px"></mj-spacer>
        <mj-social
          mode="horizontal"
          icon-size="28px"
          padding="0px"
          inner-padding="10px"
        >
          <mj-social-element
            name="facebook"
            href="#"
            background-color="transparent"
          ></mj-social-element>
          <mj-social-element
            name="twitter"
            href="#"
            background-color="transparent"
          ></mj-social-element>
          <mj-social-element
            name="instagram"
            href="#"
            background-color="transparent"
          ></mj-social-element>
        </mj-social>
        <mj-spacer height="20px"></mj-spacer>
        <mj-text padding="0px" align="center" color="#fff" line-height="22px"
          >© Self Bidding</mj-text
        >
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
